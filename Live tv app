package com.example.livetv

import android.os.Bundle
import android.widget.Button
import androidx.appcompat.app.AppCompatActivity
import androidx.media3.common.MediaItem
import androidx.media3.exoplayer.ExoPlayer
import androidx.media3.ui.PlayerView

class MainActivity : AppCompatActivity() {

    private lateinit var playerView: PlayerView
    private var player: ExoPlayer? = null

    private val saudiSunnah =
        "http://m.live.net.sa:1935/live/quran/playlist.m3u8"

    private val sonyEntertainment =
        "https://drk6xq0vhn.gpcdn.net/live/sony_ent_hd_abr/index.m3u8"

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        setContentView(R.layout.activity_main)

        playerView = findViewById(R.id.playerView)

        val btnSaudi = findViewById<Button>(R.id.btnSaudi)
        val btnSony = findViewById<Button>(R.id.btnSony)

        initializePlayer()

        btnSaudi.setOnClickListener {
            playChannel(saudiSunnah)
        }

        btnSony.setOnClickListener {
            playChannel(sonyEntertainment)
        }
    }

    private fun initializePlayer() {

        player = ExoPlayer.Builder(this).build()

        playerView.player = player

        playChannel(saudiSunnah)
    }

    private fun playChannel(url: String) {

        val mediaItem = MediaItem.fromUri(url)

        player?.apply {
            setMediaItem(mediaItem)
            prepare()
            play()
        }
    }

    override fun onDestroy() {
        super.onDestroy()

        player?.release()
        player = null
    }
}

